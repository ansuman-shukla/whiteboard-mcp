{
  "name": "@ansuman-shukla/whiteboard-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.ansuman-shukla/whiteboard-mcp",
  "description": "Local, offline Excalidraw whiteboard MCP server: your coding agent (Claude Code, Codex, Cursor, Gemini CLI, VS Code) draws diagrams live beside the chat and sees what you draw back. Also a CLI.",
  "type": "module",
  "bin": {
    "whiteboard-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "readme:art": "node scripts/render-readme-art.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:soak": "npm run build:server && node --expose-gc tests/perf/soak.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:soak && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "excalidraw",
    "excalidraw-mcp",
    "whiteboard",
    "whiteboard-mcp",
    "canvas",
    "diagram",
    "diagrams",
    "architecture-diagram",
    "flowchart",
    "mermaid",
    "drawing",
    "visualization",
    "offline",
    "local-first",
    "coding-agent",
    "ai-agent",
    "llm",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "gemini-cli",
    "vscode",
    "windsurf",
    "opencode",
    "devin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Ansuman Shukla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansuman-shukla/whiteboard-mcp.git"
  },
  "homepage": "https://github.com/ansuman-shukla/whiteboard-mcp#readme",
  "bugs": {
    "url": "https://github.com/ansuman-shukla/whiteboard-mcp/issues"
  }
}
