{
  "name": "whiteboard-mcp",
  "displayName": "Whiteboard MCP",
  "description": "Shows the live whiteboards your coding agents draw with whiteboard-mcp beside the chat, in the window the agent runs in.",
  "version": "0.1.0",
  "publisher": "ansuman-shukla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ansuman-shukla/whiteboard-mcp.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mcp",
    "whiteboard",
    "excalidraw",
    "diagrams",
    "agent"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "whiteboardMcp.openBoard",
        "title": "Open Board",
        "category": "Whiteboard"
      }
    ],
    "configuration": {
      "title": "Whiteboard MCP",
      "properties": {
        "whiteboardMcp.home": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "whiteboard-mcp state folder (default: WHITEBOARD_HOME, else ~/.whiteboard-mcp)."
        }
      }
    }
  }
}
